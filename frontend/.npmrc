# Without this, `npm install` here hits a real npm/arborist bug
# ("Cannot read properties of null (reading 'edgesOut')") while resolving
# vitest's peer dependency tree on npm 10.8.2 -- not a conflict in this
# project's own dependencies, a bug in npm's resolver itself. Pinned here
# so both local installs and CI behave the same way without needing to
# remember the flag.
legacy-peer-deps=true
