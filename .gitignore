# dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# build / runtime
dist/
build/
*.log
coverage/

# local state
*.sqlite
*.sqlite-shm
*.sqlite-wal
worker-state/

# database backups (scripts/db_backup.sh) -- real dumps of a real local
# database, potentially containing real user data; never something to
# commit. A real deployment ships these to S3/GCS, not git (see
# docs/backup-restore.md).
backups/

# os
.DS_Store
